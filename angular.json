{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "defaultProject": "alpha-konstruksi-nusantara-web",
  "projects": {
    "alpha-konstruksi-nusantara-web": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/alpha-konstruksi-nusantara-web/browser",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "node_modules/bootstrap/scss/bootstrap.scss",
              "node_modules/slick-carousel/slick/slick.scss",
              "node_modules/slick-carousel/slick/slick-theme.scss",
              "node_modules/aos/dist/aos.css",
              "src/styles.css"
            ],
            "scripts": [
              "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js",
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/slick-carousel/slick/slick.min.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all",
              "localize": true
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "en": {
              "localize": ["en"],
              "outputPath": "dist/alpha-konstruksi-nusantara-web",
              "i18nMissingTranslation": "error"
            },
            "zh": {
              "localize": ["zh"],
              "outputPath": "dist/alpha-konstruksi-nusantara-web",
              "i18nMissingTranslation": "error"
            },
            "id": {
              "localize": ["id"],
              "outputPath": "dist/alpha-konstruksi-nusantara-web",
              "i18nMissingTranslation": "error"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "alpha-konstruksi-nusantara-web:build:production"
            },
            "development": {
              "browserTarget": "alpha-konstruksi-nusantara-web:build:development"
            },
            "en": {
              "browserTarget": "alpha-konstruksi-nusantara-web:build:en"
            },
            "zh": {
              "browserTarget": "alpha-konstruksi-nusantara-web:build:zh"
            },
            "id": {
              "browserTarget": "alpha-konstruksi-nusantara-web:build:id"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "alpha-konstruksi-nusantara-web:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "tsconfig.spec.json",
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "node_modules/bootstrap/scss/bootstrap.scss",
              "node_modules/slick-carousel/slick/slick.scss",
              "node_modules/slick-carousel/slick/slick-theme.scss",
              "node_modules/aos/dist/aos.css",
              "src/styles.css"
            ],
            "scripts": [
              "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js",
              "node_modules/jquery/dist/jquery.min.js",
              "node_modules/slick-carousel/slick/slick.min.js"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        },
        "server": {
          "builder": "@angular-devkit/build-angular:server",
          "options": {
            "outputPath": "dist/alpha-konstruksi-nusantara-web/server",
            "main": "server.ts",
            "tsConfig": "tsconfig.server.json"
          },
          "configurations": {
            "production": {
              "outputHashing": "media",
              "localize": true,
              "optimization": true
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false,
              "vendorChunk": true
            },
            "en": {
              "i18nMissingTranslation": "error"
            },
            "zh": {
              "i18nMissingTranslation": "error"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-ssr": {
          "builder": "@nguniversal/builders:ssr-dev-server",
          "configurations": {
            "development": {
              "browserTarget": "alpha-konstruksi-nusantara-web:build:development",
              "serverTarget": "alpha-konstruksi-nusantara-web:server:development"
            },
            "production": {
              "browserTarget": "alpha-konstruksi-nusantara-web:build:production",
              "serverTarget": "alpha-konstruksi-nusantara-web:server:production"
            }
          },
          "defaultConfiguration": "development"
        },
        "prerender": {
          "builder": "@nguniversal/builders:prerender",
          "options": {
            "routes": ["/"]
          },
          "configurations": {
            "production": {
              "browserTarget": "alpha-konstruksi-nusantara-web:build:production",
              "serverTarget": "alpha-konstruksi-nusantara-web:server:production"
            },
            "development": {
              "browserTarget": "alpha-konstruksi-nusantara-web:build:development",
              "serverTarget": "alpha-konstruksi-nusantara-web:server:development"
            }
          },
          "defaultConfiguration": "production"
        }
      },
      "i18n": {
        "sourceLocale": {
          "code": "id",
          "baseHref": "/"
        },
        "locales": {
          "en": {
            "translation": "src/locale/messages.en.xlf",
            "baseHref": "/"
          },
          "zh": {
            "translation": "src/locale/messages.zh.xlf",
            "baseHref": "/"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "c1e8d012-2ba8-4ba4-875e-a7921e7b202d"
  }
}
